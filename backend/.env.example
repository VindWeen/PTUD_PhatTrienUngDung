# ==============================================================================
# HỆ THỐNG QUẢN LÝ HỒ SƠ THÀNH TÍCH SỐ & HỖ TRỢ XÉT DUYỆT KHEN THƯỞNG LHU
# Cấu hình biến môi trường mẫu cho Backend (Supabase PostgreSQL)
# ==============================================================================
# QUY TẮC BẢO MẬT: DB URL và mật khẩu chỉ lưu ở file .env backend, TUYỆT ĐỐI KHÔNG commit vào Git.
# ==============================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Danh sách CORS cho phép (chuỗi đơn hoặc nhiều domain phân tách bởi dấu phẩy)
# Ví dụ local: http://localhost:5173
# Ví dụ triển khai demo: http://localhost:5173,https://ptud-demo.vercel.app
CORS_ORIGIN=http://localhost:5173

# Cấu hình Cookie HttpOnly (Dành cho triển khai HTTPS / Cloud Demo)
# Mặc định dev: false, prod: true (hoặc ép bật nếu triển khai TLS/HTTPS)
COOKIE_SECURE=false
# 'lax' cho same-site hoặc local; 'none' cho cross-site HTTPS (FE & BE khác domain)
COOKIE_SAME_SITE=lax
# Tùy chọn đặt cookie domain (để trống cho domain mặc định)
# COOKIE_DOMAIN=.lhu.edu.vn

# ------------------------------------------------------------------------------
# Cấu hình Kết nối Supabase PostgreSQL (Chọn 1 trong 2 cách bên dưới)
# ------------------------------------------------------------------------------
# Cách 1: Sử dụng chuỗi kết nối tổng hợp (DATABASE_URL hoặc SUPABASE_DB_URL)
# - Direct Connection (Port 5432):
#   SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# - Session/Transaction Pooler (Port 6543 - khuyên dùng cho mạng IPv4):
#   SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Cách 2: Sử dụng các biến kết nối thành phần (Local Docker / Supabase CLI / Direct)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_postgres_password
DB_SSL=false
DB_CONNECTION_TIMEOUT=15000

# Cấu hình Connection Pool pg
DB_POOL_MIN=2
DB_POOL_MAX=10

# Cấu hình Xác thực JWT (JSON Web Token)
JWT_ACCESS_SECRET=ptud_lhu_super_secret_access_key_2026_dev_only
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=ptud_lhu_super_secret_refresh_key_2026_dev_only
JWT_REFRESH_EXPIRES_IN=7d

# Private Storage (Quản lý file chứng thực trên Backend riêng, không expose Supabase public bucket)
# STORAGE_DIR có thể chỉ định đường dẫn tuyệt đối hoặc tương đối tới kho file minh chứng
STORAGE_DIR=../storage/private/evidences
UPLOAD_DIR=../storage/evidences
MAX_FILE_SIZE_BYTES=10485760

# ==============================================================================
# Cấu hình AI Provider Adapter (W3-Q3: Server-only, Free Tier Only)
# ==============================================================================
# Nhà cung cấp mặc định: 'groq' | 'openrouter' | 'mock'
AI_PROVIDER=groq

# Cấu hình Groq API (Free Tier: llama-3.1-8b-instant, gemma2-9b-it)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Cấu hình OpenRouter API (Free Tier: meta-llama/llama-3.2-3b-instruct:free, google/gemini-2.0-flash-exp:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Cơ chế Quản lý Tài nguyên & Độ trễ
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_CACHE_ENABLED=true
