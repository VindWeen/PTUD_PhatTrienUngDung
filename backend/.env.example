# Copy file này thành backend/.env rồi điền các giá trị riêng.
# Không commit .env; DB credentials, JWT secrets và pool token chỉ giữ ở backend.

# Server local
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL: copy Connection string từ Supabase → Connect.
# Thay toàn bộ URL bên dưới bằng URL thật; URL-encode ký tự đặc biệt trong password.
# Chỉ cần một URL, không cần thêm DB_HOST/DB_USER/DB_PASSWORD hoặc SUPABASE_DB_URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Hai chuỗi ngẫu nhiên KHÁC NHAU, mỗi chuỗi ít nhất 32 ký tự.
JWT_ACCESS_SECRET=replace_with_a_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret_at_least_32_chars

# Kho minh chứng private. Đường dẫn này tính từ cwd khi chạy trong thư mục backend.
# Khi deploy, đổi sang đường dẫn tuyệt đối trên ổ đĩa lưu trữ bền vững của server.
STORAGE_DIR=../storage/private/evidences

# Cloudflare AI pool: token là giá trị POOL_ACCESS_TOKEN đã đặt trên Worker.
# Không đưa GROQ_KEYS/OPENROUTER_KEYS vào backend: các key đó nằm trên Cloudflare.
# Khi có AI_POOL_URL, các lời gọi AI thật đi qua Worker thay vì key provider trực tiếp.
AI_POOL_URL=https://ai-pool.fw62262.workers.dev
AI_POOL_TOKEN=change_me_pool_token
# auto: ưu tiên Groq rồi OpenRouter; groq/openrouter: chỉ dùng pool chỉ định.
AI_POOL_MODE=auto
# Worker thử upstream tối đa 25 giây; backend cần timeout lớn hơn khoảng đó.
AI_TIMEOUT_MS=35000
# Worker đã xử lý retry/fallback; tránh backend lặp lại cả chuỗi gọi pool.
AI_MAX_RETRIES=0
AI_CACHE_ENABLED=true

# Tùy chọn khi deploy: thêm/đổi nếu cần. Các cấu hình còn lại dùng mặc định trong env.js.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# MAX_FILE_SIZE_BYTES=10485760
