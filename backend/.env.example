# HỆ THỐNG QUẢN LÝ HỒ SƠ THÀNH TÍCH SỐ & HỖ TRỢ XÉT DUYỆT KHEN THƯỞNG LHU
# Cấu hình biến môi trường mẫu cho Backend
# ==============================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Cấu hình Microsoft SQL Server (MSSQL)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=PTUD_AchievementDB
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Auth
JWT_ACCESS_SECRET=ptud_lhu_super_secret_access_key_2026_dev_only
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=ptud_lhu_super_secret_refresh_key_2026_dev_only
JWT_REFRESH_EXPIRES_IN=7d

# Private Storage
UPLOAD_DIR=../storage/evidences
MAX_FILE_SIZE_BYTES=10485760
