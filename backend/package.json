{
  "name": "ptud-backend",
  "version": "1.0.0",
  "description": "Backend REST API v1 cho Hệ thống Quản lý Hồ sơ Thành tích Số & Hỗ trợ Xét duyệt Khen thưởng LHU",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node ../database/scripts/migrate.js up",
    "migrate:status": "node ../database/scripts/migrate.js status",
    "seed": "node ../database/scripts/seed.js",
    "test": "node tests/runner.js"
  },
  "keywords": [
    "express",
    "mssql",
    "ptud",
    "lhu",
    "rest-api"
  ],
  "author": "Tạ Trần Vinh Quang",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
