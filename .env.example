# ==============================================================================
# HỆ THỐNG QUẢN LÝ HỒ SƠ THÀNH TÍCH SỐ & HỖ TRỢ XÉT DUYỆT KHEN THƯỞNG LHU
# Cấu hình biến môi trường mẫu (Environment Configuration Template)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env trong thư mục backend/ hoặc root:
#   cp .env.example backend/.env
# ==============================================================================

# Cấu hình Máy chủ Web (Express Server)
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Cấu hình Cơ sở dữ liệu Microsoft SQL Server (MSSQL)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=PTUD_AchievementDB
# Sử dụng tài khoản SQL Server Authentication (nếu có)
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
# Cấu hình kết nối Driver Tedious
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000

# Cấu hình Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Cấu hình Xác thực JWT (JSON Web Token)
# LƯU Ý: Khóa bí mật trong môi trường production phải có độ dài tối thiểu 32 ký tự ngẫu nhiên
JWT_ACCESS_SECRET=ptud_lhu_super_secret_access_key_2026_dev_only
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=ptud_lhu_super_secret_refresh_key_2026_dev_only
JWT_REFRESH_EXPIRES_IN=7d

# Cấu hình Lưu trữ Minh chứng (Private Storage)
UPLOAD_DIR=./storage/evidences
MAX_FILE_SIZE_BYTES=10485760
