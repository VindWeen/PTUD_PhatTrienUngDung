# ==============================================================================
# HỆ THỐNG QUẢN LÝ HỒ SƠ THÀNH TÍCH SỐ & HỖ TRỢ XÉT DUYỆT KHEN THƯỞNG LHU
# Cấu hình biến môi trường mẫu (Environment Configuration Template)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env trong thư mục backend/ hoặc root:
#   cp .env.example backend/.env
# ==============================================================================

# Cấu hình Máy chủ Web (Express Server)
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Cấu hình Kết nối Cơ sở dữ liệu Supabase PostgreSQL
# Direct Connection (Port 5432) hoặc Session Pooler (Port 6543):
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_postgres_password
DB_SSL=false
DB_CONNECTION_TIMEOUT=15000

# Cấu hình pg Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Cấu hình Xác thực JWT (JSON Web Token)
JWT_ACCESS_SECRET=ptud_lhu_super_secret_access_key_2026_dev_only
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=ptud_lhu_super_secret_refresh_key_2026_dev_only
JWT_REFRESH_EXPIRES_IN=7d

# Cấu hình Lưu trữ Minh chứng (Private Storage trên Backend)
UPLOAD_DIR=./storage/evidences
MAX_FILE_SIZE_BYTES=10485760
