                  },
                  "recognitionYear": {
                    "type": "integer",
                    "minimum": 1990,
                    "maximum": 2100
                  },
                  "achievementIds": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "replacesAwardRecordId": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "awardTypeId",
