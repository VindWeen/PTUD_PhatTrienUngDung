{
  "openapi": "3.0.3",
  "info": {
    "title": "W3-P2 Internal KPI",
    "version": "1.0.0",
    "description": "Hợp đồng bổ sung; xem KPI_W3_P2.md cho quyền, CSV và workflow. GoalInput UNIT cần organizationUnitId. Date/amount được kiểm thêm bằng Zod/backend. Không có AI hay KPI ngoài."
  },
