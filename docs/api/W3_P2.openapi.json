          "W3-P2 KPI"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Goal"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payload/CSV/danh mục không hợp lệ"
          },
          "401": {
            "description": "Chưa đăng nhập hoặc tài khoản không ACTIVE"
          },
          "403": {
            "description": "Không phải chính chủ/đại diện hợp lệ"
          },
          "404": {
            "description": "Không tìm thấy"
          },
          "409": {
            "description": "Version/trùng kỳ/trạng thái hoặc kết quả đã liên kết"
          }
        },
        "parameters": [
          {
            "name": "subjectType",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "LECTURER",
                "UNIT"
              ],
              "default": "LECTURER"
            }
          },
          {
            "name": "organizationUnitId",
            "in": "query",
            "description": "Bắt buộc khi UNIT; không nhận khi LECTURER",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        ]
      },
